{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "criteria"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "explanation", "evidence", "action_items"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "result": {
            "type": "string",
            "enum": ["MET", "PARTIAL", "NOT_MET", "NOT_VERIFIABLE"]
          },
          "explanation": {"type": "string", "minLength": 1, "maxLength": 3000},
          "evidence": {
            "type": "array",
            "items": {"type": "string", "minLength": 1, "maxLength": 1000},
            "maxItems": 20
          },
          "action_items": {
            "type": "array",
            "items": {"type": "string", "minLength": 1, "maxLength": 1000},
            "maxItems": 20
          }
        }
      }
    }
  }
}
