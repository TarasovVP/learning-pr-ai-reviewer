{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TarasovVP/learning-pr-ai-reviewer/schemas/assessment.schema.json",
  "title": "Learning PR AI Review Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "title", "description", "relatedPaths", "requirements"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "relatedPaths": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "criteria", "acceptableEvidence", "statusRules"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "title": {"type": "string", "minLength": 1},
          "criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "acceptableEvidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "statusRules": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
